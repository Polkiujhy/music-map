#!/usr/bin/env php
<?php

use App\Integrations\PlatformAccess\PlatformAccessProtocol;
use App\Integrations\PlatformAccess\ProbeFailure;
use App\Integrations\PlatformAccess\ProbeInvocation;
use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$input = new ArgvInput;
$tokens = $input->getRawTokens(false);
$isStandardHelp = ($tokens[0] ?? null) === 'help'
    && ($tokens[1] ?? null) === PlatformAccessProtocol::COMMAND;

if (! $isStandardHelp && ProbeInvocation::targetsCommand($tokens)) {
    $invocation = ProbeInvocation::fromRawTokens($tokens);

    if ($invocation instanceof ProbeFailure) {
        fwrite(STDERR, $invocation->stderr());

        exit($invocation->exitCode());
    }
}

$status = $app->handleCommand($input);

exit($status);
