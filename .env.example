APP_NAME="Music Map"
APP_ENV=production
APP_KEY=__REQUIRED_RUNTIME_SECRET__
APP_DEBUG=false
APP_URL=https://music-map.example.invalid

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=shared-postgres
DB_PORT=5432
DB_DATABASE=music_map
DB_USERNAME=music_map
DB_PASSWORD=__REQUIRED_RUNTIME_SECRET__
DB_SSLMODE=prefer
DB_STARTUP_MAX_ATTEMPTS=7
DB_STARTUP_INITIAL_BACKOFF_MS=500
DB_STARTUP_MAX_BACKOFF_MS=8000
DB_STARTUP_CONNECT_TIMEOUT_SECONDS=3
DB_STARTUP_TOTAL_TIMEOUT_SECONDS=45

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
CACHE_PREFIX=music_map_

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.invalid
MAIL_PORT=465
MAIL_USERNAME=__REQUIRED_RUNTIME_SECRET__
MAIL_PASSWORD=__REQUIRED_RUNTIME_SECRET__
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=__REQUIRED_RUNTIME_SECRET__
GOOGLE_CLIENT_SECRET=__REQUIRED_RUNTIME_SECRET__
GOOGLE_REDIRECT_URI=https://music-map.example.invalid/auth/google/callback

SPOTIFY_CLIENT_ID=__REQUIRED_RUNTIME_SECRET__
SPOTIFY_CLIENT_SECRET=__REQUIRED_RUNTIME_SECRET__
SPOTIFY_REDIRECT_URI=https://music-map.example.invalid/integrations/spotify/callback
SPOTIFY_TECHNICAL_REFRESH_TOKEN=__REQUIRED_RUNTIME_SECRET__

YOUTUBE_API_KEY=__REQUIRED_RUNTIME_SECRET__
YOUTUBE_REDIRECT_URI=https://music-map.example.invalid/integrations/youtube/callback
YOUTUBE_TECHNICAL_REFRESH_TOKEN=__REQUIRED_RUNTIME_SECRET__

VITE_APP_NAME="${APP_NAME}"
